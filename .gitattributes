# Normalize text files to LF across platforms so clean Windows clones with
# core.autocrlf=true never inflate packed archive byte counts.
* text=auto eol=lf

# Agent ownership and migration fixtures depend on the exact shipped bytes.
# Preserve their line endings across clones instead of applying core.autocrlf.
integrations/targets/codex/skills/dsh-taskbridge/SKILL.md -text
integrations/targets/codex/skills/dsh-taskbridge/rules-reference-*.md -text
integrations/targets/antigravity/skills/dsh-taskbridge/SKILL.md -text
integrations/targets/antigravity/agents/dsh-taskbridge.md -text
tests/fixtures/*.toml -text whitespace=cr-at-eol
tests/fixtures/**/*.md -text
# The generated client bundle is compared byte for byte by `build-client --check`
# (it is written with LF). Converting it on checkout would make that check fail on a
# clean clone even when the bundle is in sync with its sources.
lib/client.js -text
