{
  "name": "dsh-taskbridge",
  "version": "1.9.3",
  "description": "面向 DeepSeek Harness（DSH）的跨宿主派工桥接插件：让上层宿主端专注架构规划与交付验收，将繁重的编码实现与测试调测交给 DSH 黑盒执行以节省主力模型配额；统一封装 API、执行模型、思考强度与 Git 工作树隔离，支持一键宿主集成、低耗直调与静默长等、按需权限审批、跨包工作树复用、验收后零破坏自动写回与联动清理（已支持 Codex、Antigravity 一键接入，Claude Code / Claude Desktop 计划于 2.0 上线）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranranyya/dsh-taskbridge.git"
  },
  "homepage": "https://github.com/ranranyya/dsh-taskbridge#readme",
  "bugs": {
    "url": "https://github.com/ranranyya/dsh-taskbridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./mcp": {
      "types": "./bin/dsh-delegate-mcp.d.ts",
      "default": "./bin/dsh-delegate-mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-delegate-mcp": "bin/dsh-delegate-mcp.js",
    "dsh-delegate-codex-agent": "bin/dsh-delegate-codex-agent.js",
    "dsh-delegate-control": "bin/dsh-delegate-control.js",
    "dsh-taskbridge-mcp": "bin/dsh-delegate-mcp.js",
    "dsh-taskbridge-codex-agent": "bin/dsh-delegate-codex-agent.js",
    "dsh-taskbridge-control": "bin/dsh-delegate-control.js"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "lib/client.js",
    "lib/client.d.ts",
    "bin/dsh-delegate-mcp.js",
    "bin/dsh-delegate-mcp.d.ts",
    "bin/dsh-delegate-codex-agent.js",
    "bin/dsh-delegate-control.js",
    "bin/dsh-delegate-control.d.ts",
    "codex/skills/dsh-taskbridge/SKILL.md",
    "codex/skills/dsh-taskbridge/rules-reference-*.md",
    "antigravity/skills/dsh-taskbridge/SKILL.md",
    "antigravity/agents/dsh-taskbridge.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md",
    "docs/auth-contract.md",
    "docs/codex-integration.md",
    "docs/antigravity-integration.md",
    "docs/conversation-placement.md",
    "docs/contracts-stage-b.md",
    "docs/redaction-contract.md",
    "docs/runtime-compatibility.md",
    "docs/silent-wait.md",
    "docs/worker-permissions.md",
    "docs/workspace-contract.md",
    "docs/workspace-grouping.md",
    "icon.svg",
    "locale/*.json",
    "docs/INTRODUCTION.zh.md",
    "docs/INTRODUCTION.md",
    "docs/assets/taskbridge-workflow.zh.png",
    "docs/assets/taskbridge-workflow.en.svg",
    "docs/taskdispatch-upgrade.md",
    "docs/claude-code.md",
    "docs/plugin-market.md",
    "docs/taskbridge-upgrade.md",
    "docs/releases/1.6.0.zh.md",
    "docs/releases/1.7.0.zh.md",
    "docs/releases/1.8.0.zh.md",
    "docs/releases/1.8.1.zh.md",
    "docs/releases/1.9.0.zh.md",
    "docs/releases/1.9.1.zh.md",
    "docs/releases/1.9.2.zh.md",
    "docs/releases/1.9.3.zh.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@earendil-works/pi-ai": "^0.87.1 || ^1.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@earendil-works/pi-ai": "^0.87.1",
    "@tanstack/react-table": "8.21.3",
    "esbuild": "0.25.11",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:isolated": "node --test tests/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "build:integrations": "node scripts/build-integrations.mjs",
    "check:integrations": "node scripts/build-integrations.mjs --check",
    "mcp": "node bin/dsh-delegate-mcp.js",
    "codex-agent": "node bin/dsh-delegate-codex-agent.js",
    "control": "node bin/dsh-delegate-control.js",
    "pack:dry": "npm pack --dry-run",
    "build:market": "node scripts/build-plugin-market.mjs",
    "verify:silent-wait": "node scripts/verify-silent-wait.mjs --duration-seconds 1200"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "taskbridge",
    "codex",
    "antigravity",
    "claude-code",
    "mcp",
    "delegation"
  ],
  "author": "ranranyya",
  "icon": "./icon.svg"
}
